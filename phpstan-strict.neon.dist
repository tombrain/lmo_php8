# Neuer Code auf Stufe 8. Dateien, die typisiert und ohne globale Variablen geschrieben sind, hier eintragen.
parameters:
    level: max
    phpVersion:
        min: 80100
        max: 80599
    paths:
        - src
        - lmo/addon/spieler/src
        - lmo/addon/ticker/src
        - bin/lmo-install
        - lmo/lmo-version.php
