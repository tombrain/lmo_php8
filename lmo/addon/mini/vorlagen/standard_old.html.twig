<table style="font-size:90%;font-family:sans-serif;border-spacing:0;border-collapse:collapse;border:1px solid black;" cellspacing="0">
  <caption style="font-weight:bold;border:1px solid black;"><a style="text-decoration:underline;" href="{{ Link|default("")|raw }}">{{ Tabelle|default("")|raw }} »</a></caption>
  {% for z in Inhalt %}
  <tr style="{{ z.Style|default("")|raw }}">
    <td align="right">{{ z.Platz|default("")|raw }}</td>
    <td align="right">{{ z.TendenzIMG|default("")|raw }}</td>
    <td align="center">{{ z.TeamBild|default("")|raw }}</td>
    <td><acronym title="{{ z.TeamLang|default("")|raw }}">{{ z.Team|default("")|raw }}</acronym></td>
    <td align="right">{{ z.Tordifferenz|default("")|raw }}</td>
    <td align="right">{{ z.Punkte|default("")|raw }}</td>
  </tr>
  {% endfor %}
</table>