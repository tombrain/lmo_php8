  Die Platzhalter heissen wie dort; in Bloecken stehen sie an der Zeile (z.Name).
-#}
<style type="text/css">
p { font: bold 0.9em Helvetica, Arial, Sans-Serif; padding: 0.2em; margin: 0em; } #eins { color: white; text-shadow: 1px 1px grey, 1.5px 1.5px grey, 2px 2px grey; top: 0; left: 0; transition: all 0.3s ease-out; } #eins:hover { position: relative; top: -2px; left: -2px; text-shadow: 1px 1px grey, 1.5px 1.5px grey, 2px 2px grey, 2.5px 2.5px grey, 3px 3px grey, 3.5px 3.5px grey; }
.separate { border-spacing: 0; border-collapse: separate; } .separate td, .separate th { padding: 5px 12px; border-bottom: 1px solid green; border-right: 1px solid blue; } .separate th { background: #00BFFF; color: white; } .separate tr:last-child td:first-child { border-bottom-left-radius:10px; } .separate tr:last-child td:last-child { border-bottom-right-radius:10px; } .separate tr th:first-child, .separate tr td:first-child { border-left: 1px solid blue; } .separate tr:first-child th, .separate tr:first-child td { border-top: 1px solid blue; } .separate tr:first-child th:first-child, .separate tr:first-child td:first-child { border-top-left-radius:10px } .separate tr:first-child th:last-child, .separate tr:first-child td:last-child { border-top-right-radius:10px }
</style>
<table class="separate">
  <tr>
    <th colspan="10"><a href="{{ Link|default("")|raw }}"><p id="eins">{{ Tabelle|default("")|raw }}</p></a></th>
  </tr>
  <tr bgcolor="#00BFFF">
    <th align="center"><acronym title="Platz">P</acronym></th>
    <th></td>
    <th align="center"><acronym title="Mannschaft">Team</acronym></th>
    <th align="center"><acronym title="Spiele">S</acronym></th>
    <th align="center"><acronym title="Siege">s</acronym></th>
    <th align="center"><acronym title="Unentschieden">u</acronym></th>
    <th align="center"><acronym title="Niederlagen">n</acronym></th>
    <th align="center"><acronym title="Tore">T</acronym></th>
    <th align="center"><acronym title="Tordifferenz">TD</acronym></th>
    <th align="center"><acronym title="Punkte">P</acronym></th>
  </tr>{% for z in Inhalt %}
  <tr style="{{ z.Style|default("")|raw }}">
    <td align="center">{{ z.Platz|default("")|raw }}</td>
    <td align="center">{{ z.TendenzIMG|default("")|raw }}</td>
    <td>{{ z.TeamBild|default("")|raw }}&nbsp;<acronym title="{{ z.TeamLang|default("")|raw }} ({{ z.Team|default("")|raw }})">{{ z.TeamMittel|default("")|raw }}</acronym></td>
    <td align="center">{{ z.Spiele|default("")|raw }}</td>
    <td align="center">{{ z.Siege|default("")|raw }}</td>
    <td align="center">{{ z.Unentschieden|default("")|raw }}</td>
    <td align="center">{{ z.Niederlagen|default("")|raw }}</td>
    <td align="center">{{ z.PlusTore|default("")|raw }}:{{ z.MinusTore|default("")|raw }}</td>
    <td align="center">{{ z.Tordifferenz|default("")|raw }}</td>
    <td align="center">{{ z.Punkte|default("")|raw }}</td>
  </tr>{% endfor %}
  <tr>
    <td colspan="10" align="right">{{ ligaDatum|default("")|raw }}</th>
  </tr>
</table>