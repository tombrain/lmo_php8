<style type="text/css">
.nextgame caption, .nextgame td, .nextgame th {font-family:sans-serif;font-size:11px;color:000;white-space:nowrap;}
.nextgame table{border:none;border-collapse:collapse;border:1px solid #ccc;margin-bottom:0.5em;}
.nextgame .lost  {color: #900;}
.nextgame .win  {color: #090;}
.nextgame .draw  {color: #999;}
.nextgame .noResult {color: #000;}
.nextgame .result  {font-weight:bold;font-size:160%;}
.nextgame ul {margin:1em 0;padding:0;list-style:none;}
.nextgame caption { background:#69c;color:#fff;font-weight:bold;margin-bottom:0.3em;padding:0.2em;}
.nextgame acronym { cursor:help;border-bottom:1px dotted;color:blue; }
.nextgame small{font-size:11px;}
</style>
<table class="nextgame">
  <tr>
    <td>
      <table width="100%">
        <caption>{{ gameTxt|default("")|raw }}</caption>
        <tr>
         <th>{{ countDown|default("")|raw }}</th>
        </tr>
        <tr>
         <th>{{ gameDate|default("")|raw }} {{ gameTime|default("")|raw }}</th>
        </tr>
        <tr>
          <td align="center">{{ homeName|default("")|raw }}</td>
        </tr>
        <tr>
          <td align="center">{{ imgHomeBig|default("")|raw }}&nbsp;<span class="result">{{ homeTore|default("")|raw }}&nbsp;:&nbsp;{{ guestTore|default("")|raw }}</span>&nbsp;{{ imgGuestBig|default("")|raw }}</td>
        </tr>
        <tr>
          <td align="center">{{ guestName|default("")|raw }}</td>
        </tr>
        <tr>
          <td><small>{{ gameNote|default("")|raw }}</small></td>
        </tr>
        <tr>
          <th>{{ matchesTxt|default("")|raw }}</th>
        </tr>
        <tr>
          <td align="center">{{ winCount|default("")|raw }} / {{ drawCount|default("")|raw }} / {{ lostCount|default("")|raw }} ({{ winTxt|default("")|raw }}/{{ drawTxt|default("")|raw }}/{{ lostTxt|default("")|raw }})</td>
        </tr>
        <tr>
          <th>
            <table align="center" border="0" cellpadding="0" cellspacing="0">
             	<tr>
                <th bgcolor="#009900" height="7" width="{{ winWidth|default("")|raw }}"></th>
                <th bgcolor="#999999" height="7" width="{{ drawWidth|default("")|raw }}"></th>
                <th bgcolor="#990000" height="7" width="{{ lostWidth|default("")|raw }}"></th>
             	</tr>
            </table>
          </th>
        </tr>
        <tr>
          <td align="center">
            <ul>
        {% for z in matches %}
        <li class="{{ z.class|default("")|raw }}">{{ z.date|default("")|raw }} {{ z.time|default("")|raw }} {{ z.hTore|default("")|raw }}:{{ z.gTore|default("")|raw }} ({{ z.where|default("")|raw }}) <small>{{ z.matchingName|default("")|raw }}</small></li>
        {% endfor %}
           </ul>
         </td>
       </tr>
       <tr>
         <td align="right"><small>{{ ligaDatum|default("")|raw }}&nbsp;{{ copy|default("")|raw }}</small></td>
       </tr>
      </table>
      {% for z in previous %}
      <table width="100%">
        <caption>{{ z.previous_gameTxt|default("")|raw }}</caption>
        <tr>
         <th>{{ z.previous_gameDate|default("")|raw }} {{ z.previous_gameTime|default("")|raw }}</th>
        </tr>
        <tr>
          <td align="center">{{ z.previous_imgHomeSmall|default("")|raw }}</td>
        </tr>
        <tr>
          <td align="center">{{ z.previous_homeName|default("")|raw }}</td>
        </tr>
        <tr>
          <th class="result">{{ z.previous_hTore|default("")|raw }} : {{ z.previous_gTore|default("")|raw }}</th>
        </tr>
        <tr>
          <td align="center">{{ z.previous_guestName|default("")|raw }}</td>
        </tr>
        <tr>
          <td align="center">{{ z.previous_imgGuestSmall|default("")|raw }}</td>
        </tr>
      </table>
      {% endfor %}
    </td>
  </tr>
</table>