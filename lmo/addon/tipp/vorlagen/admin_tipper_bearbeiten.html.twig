{# Einen Tipper bearbeiten oder anlegen (Lmo\Addon\Tipp\AdminTipperBearbeitenController), bis 4.5 lmo-admintippuseredit.php #}
  <table class="lmoMiddle" cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td align="center"><h1>{{ neu ? t[136]|raw : t[106]|raw }}</h1></td>
    </tr>
    <tr>
      <td align="center">
        <form name="lmotippedit" action="{{ adresse }}" method="post" onSubmit="if (this.nick.value=="") {alert ('{{ t[112]|raw }}');this.nick.focus();return false;}">
          <input type="hidden" name="action" value="admin">
          <input type="hidden" name="todo" value="tippuseredit">
          <input type="hidden" name="newpage" value="{{ neu ? '1' : '0' }}">
          <table class="lmoInner" cellspacing="0" cellpadding="0" border="0">
            <tr>
              <td align="right">&nbsp;{{ t[23]|raw }}</td>
              <td align="left">{% if neu %}

                <input class="lmo-formular-input" type="text" name="nick" value="{{ nick|raw }}">{% else %}

                <input type="hidden" name="nick" value="{{ nick|raw }}"><strong>{{ daten[0]|raw }}</strong>{% endif %}</td>
            </tr>
            <tr>
              <td align="right">&nbsp;{% if neu %}{{ text[308]|raw }}{% else %}<acronym title="{{ t[304]|raw }}">{{ text[308]|raw }}</acronym>{% endif %}</td>
              <td align="left">{% if neu %}

                <input class="lmo-formular-input" type="text" name="xtipperpass" value="{{ kennwort }}">{% else %}

                <input class="lmo-formular-input" type="password" name="xtipperpass" size="25" maxlength="100" value="">{% endif %}</td>
            </tr>
            <tr>
              <td align="right">&nbsp;{{ t[14]|raw }}</td>
              <td align="left"><input class="lmo-formular-input" type="text" name="xtippervorname" size="25" maxlength="32" value="{{ vorname|raw }}"></td>
            </tr>
            <tr>
              <td align="right">&nbsp;{{ t[15]|raw }}</td>
              <td align="left"><input class="lmo-formular-input" type="text" name="xtippernachname" size="25" maxlength="32" value="{{ nachname|raw }}"></td>
            </tr>
            <tr>
              <td align="right">&nbsp;{{ t[126]|raw }}</td>
              <td align="left"><input class="lmo-formular-input" type="text" name="xtipperstrasse" size="25" maxlength="32" value="{{ daten[6]|raw }}"></td>
            </tr>
            <tr>
              <td align="right">&nbsp;{{ t[127]|raw }}</td>
              <td align="left"><input class="lmo-formular-input" type="text" name="xtipperplz" size="7" maxlength="5" value="{{ daten[7]|raw }}"></td>
            </tr>
            <tr>
              <td align="right">&nbsp;{{ t[128]|raw }}</td>
              <td align="left"><input class="lmo-formular-input" type="text" name="xtipperort" size="25" maxlength="32" value="{{ daten[8]|raw }}"></td>
            </tr>
            <tr>
              <td align="right">&nbsp;{{ t[16]|raw }}</td>
              <td align="left"><input class="lmo-formular-input" type="text" name="xtipperemail" size="25" maxlength="64" value="{{ daten[4]|raw }}"></td>
            </tr>
            <tr>
              <td>&nbsp;</td>
              <td align="left"><input type="checkbox" name="xfrei"{% if daten[2] == 5 %} checked{% endif %}>{{ t[147]|raw }}</td>
            </tr>
            <tr>
              <th align="left" colspan="2">{{ t[165]|raw }}</th>
            </tr>
            <tr>
              <td>&nbsp;</td>
              <td align="left">
                <input type="checkbox" name="xnews"{% if daten[9] != -1 %} checked{% endif %}>{{ t[206]|raw }}
              </td>
            </tr>
            <tr>
              <td>&nbsp;</td>
              <td align="left">
                <input type="checkbox" name="xremind"{% if daten[10] != -1 %} checked{% endif %}>{{ t[167]|raw }}
              </td>
            </tr>
{% if mitVerein %}
            <tr>
              <th align="left" colspan="2">{{ t[27]|raw }}</th>
            </tr>
            <tr>
              <td align="left" colspan="2"><input type="radio" name="xtippervereinradio" value="0" id="0"{% if vereinswahl == 0 %} checked{% endif %}>{{ t[50]|raw }}</td>
            </tr>
            <tr>
              <td align="left"><input type="radio" name="xtippervereinradio" value="1" id="1"{% if vereinswahl == 1 %} checked{% endif %}>{{ t[48]|raw }}</td>
              <td align="left">
                <select name="xtippervereinalt" onChange="xtippervereinradio[1].checked=true"><option value=" "{% if vereinAlt == '' %} selected{% endif %}>{{ t[51]|raw }}</option>
{% for v in vereine %}
  <option value="{{ v.name|raw }}"{% if vereinAlt == v.name %} selected{% endif %}>{{ v.name|raw }} [{{ v.tipper }}]</option>
{% endfor %}
                </select>
              </td>
            </tr>
            <tr>
              <td align="left"><input type="radio" name="xtippervereinradio" value="2" id="2"{% if vereinswahl == 2 %} checked{% endif %}>{{ t[49]|raw }}</td>
              <td align="left"><input class="lmo-formular-input" type="text" name="xtippervereinneu" size="25" maxlength="32" value="{{ vereinNeu|raw }}" onFocus="xtippervereinradio[2].checked=true"></td>
            </tr>
{% endif %}
            <tr>
              <th align="left" colspan="2">{{ t[273]|raw }}</th>
            </tr>
            <tr>
              <td class="lmost5" colspan="2">{% for liga in ligen %}<input type="checkbox" name="xtipperligen[]" value="{{ liga.datei|raw }}"{% if liga.angekreuzt %}checked{% endif %}>{{ liga.name|raw }}<br>{% else %}
        <tr>
          <td></td>
          <td><li>[ {{ text[223]|raw }} ]</li></td>
          <td></td>
        </tr>
{% endfor %}</td>
            </tr>
            <tr>
              <td align="left">
                <a href="{{ adresse }}?action=admin&amp;todo=tippuser&amp;del={{ daten[0]|raw }}" onClick="return confirm('{{ text[499]|raw }}');"><img src="{{ bilder }}/delete.svg" border="0" height="18" alt="{{ text[82]|raw }}"></a>
                &nbsp;&nbsp;<a href="{{ adresse }}?action=admin&amp;todo=tippuser">{{ text[544]|raw }}</a>
              </td>
              <td align="right">
                <input class="lmo-formular-button" type="submit" name="xtippersub" value="{{ text[329]|raw }}">
              </td>
            </tr>
            <tr>
              <td class="lmoFooter" colspan="2" align="right"><strong>{{ t[82]|raw }}</strong> {{ t[137]|raw }}</td>
            </tr>
          </table>
        </form>
      </td>
    </tr>
  </table>
