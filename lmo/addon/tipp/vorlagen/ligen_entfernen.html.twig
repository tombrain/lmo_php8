{#- Ligen entfernen (Lmo\Addon\Tipp\KontoController). -#}
<table class="lmoInner" cellspacing="0" cellpadding="0" border="0">
  <caption>{{ tipper|raw }}</caption>
  <tr>
    <th colspan="3" align="center">{{ t[266]|raw }}</th>
  </tr>
  <tr>
    <td width="20">&nbsp;</td>
    <td align="left">{% if not gespeichert %}
      <form name="lmotippedit" action="{{ adresse|raw }}" method="post">
        <input type="hidden" name="action" value="tipp">
        <input type="hidden" name="todo" value="delligen">
        <input type="hidden" name="newpage" value="1">
{% include 'ligen_liste.html.twig' %}
{% if ligen is not empty %}
        <input class="lmo-formular-button" type="submit" name="xtippersub" value="{{ t[268]|raw }}">
{% endif %}
      </form>
      <p class="error"><img src="{{ bilder|raw }}/wrong.svg" border="0" width="20" alt=""> <strong>{{ t[82]|raw }}</strong> {{ t[267]|raw }}</p>
{% endif %}
    </td>
    <td width="20">&nbsp;</td>
  </tr>
{% if gespeichert %}
  <tr>
    <td colspan="3" align="center"><p class="message"><img src="{{ bilder|raw }}/right.svg" border="0" width="20" alt=""> {{ t[269]|raw }}</p></td>
  </tr>
{% endif %}
{% if gespeichert or ligen is empty %}
  <tr>
    <td colspan="3" class="lmoFooter" align="right"><a href="{{ adresse|raw }}?action=tipp&amp;todo=">{{ text[5]|raw }} {{ t[1]|raw }}</a></td>
  </tr>
{% endif %}
</table>
