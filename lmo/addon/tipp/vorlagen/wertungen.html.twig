{#- Auswertungen der Ligen (Lmo\Addon\Tipp\Tippligen::wertungen()); klasse: Klasse der Listenpunkte. -#}
{% for wertung in wertungen %}
        <li{% if klasse %} class="{{ klasse }}"{% endif %}>
          <a href="{{ adda|raw }}wert&amp;file={{ wertung.link|raw }}">{% if wertung.gesamt %}<strong>{{ wertung.name|raw }}</strong>{% else %}{{ wertung.name|raw }}{% endif %}</a>{% if wertung.stand is not null %}<br><small>{{ t[83]|raw }}: {{ wertung.stand }}</small>{% endif %}
        </li>
{% endfor %}
