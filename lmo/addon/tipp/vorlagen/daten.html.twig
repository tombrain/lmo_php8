{#- Persoenliche Daten (Lmo\Addon\Tipp\KontoController). Texte und Name des Tippers sind fertiges HTML; gespeicherte Daten und Eingaben werden maskiert. -#}
<table class="lmoInner" cellspacing="0" cellpadding="0" border="0">
  <caption>{{ tipper|raw }}</caption>
  <tr>
    <th align="center">{{ t[106]|raw }}{% if team %} / {{ t[2]|raw }}{% endif %}</th>
  </tr>
{% if not gespeichert %}
  <tr>
    <td align="center">
      <form name="lmotippedit" action="{{ adresse|raw }}" method="post">
        <input type="hidden" name="action" value="tipp">
        <input type="hidden" name="todo" value="daten">
        <input type="hidden" name="newpage" value="1">
        <table class="lmoInner" cellspacing="0" cellpadding="0" border="0">
{% if realname %}
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" align="right"> {{ t[14]|raw }} &nbsp;</td>
            <td class="nobr" align="left"><input class="lmo-formular-input" type="text" name="xtippervorname" size="25" maxlength="32" value="{{ vorname }}"> &nbsp;</td>
          </tr>
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" align="right"> {{ t[15]|raw }} &nbsp;</td>
            <td class="nobr" align="left"><input class="lmo-formular-input" type="text" name="xtippernachname" size="25" maxlength="32" value="{{ nachname }}"> &nbsp;</td>
          </tr>
{% endif %}
{% if mitAdresse %}
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" align="right"> {{ t[126]|raw }} &nbsp;</td>
            <td class="nobr" align="left"><input class="lmo-formular-input" type="text" name="xtipperstrasse" size="25" maxlength="32" value="{{ gespeicherter.feld(6) }}"> &nbsp;</td>
          </tr>
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" align="right"> {{ t[127]|raw }} &nbsp;</td>
            <td class="nobr" align="left"><input class="lmo-formular-input" type="text" name="xtipperplz" size="7" maxlength="5" value="{{ gespeicherter.feld(7) }}"> &nbsp;</td>
          </tr>
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" align="right"> {{ t[128]|raw }} &nbsp;</td>
            <td class="nobr" align="left"><input class="lmo-formular-input" type="text" name="xtipperort" size="25" maxlength="32" value="{{ gespeicherter.feld(8) }}"> &nbsp;</td>
          </tr>
{% endif %}
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" align="right"> {{ t[16]|raw }} &nbsp;</td>
            <td class="nobr" align="left"><input class="lmo-formular-input" type="text" name="xtipperemail" size="25" maxlength="64" value="{{ gespeicherter.email }}"> &nbsp;</td>
          </tr>
{% if email2 %}
          <tr>
            <td width="20">&nbsp;</td>
            <td align="right"><acronym title="{{ t[300]|raw }}"> {{ t[16]|raw }} {{ t[19]|raw }}</acronym></td>
            <td align="left"><input class="lmo-formular-input" type="text" name="xtipperemail2" size="25" maxlength="64" value="{{ gespeicherter.email }}"></td>
          </tr>
{% endif %}
          <tr>
            <th align="left" colspan="3">{{ t[207]|raw }}</th>
          </tr>
          <tr>
            <td width="20">&nbsp;</td>
            <td>&nbsp;</td>
            <td class="nobr" align="left">
            <input type="checkbox" name="xnews" value="1" {% if newsletter %}checked{% endif %}>{{ t[206]|raw }}<br>
            <input type="checkbox" name="xremind" value="1" {% if erinnerung %}checked{% endif %}>{{ t[167]|raw }}
            </td>
          </tr>
{% if team %}
          <tr>
            <th align="left" colspan="3">{{ t[47]|raw }}</th>
          </tr>
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" colspan="2" align="left"><input type="radio" name="xtippervereinradio" value="0" {% if vereinswahl == 0 %}checked{% endif %}> {{ t[50]|raw }}</td>
          </tr>
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" align="left"><input type="radio" name="xtippervereinradio" value="1" {% if vereinswahl == 1 %}checked{% endif %}> {{ t[48]|raw }} &nbsp;</td>
            <td class="nobr" align="left">
              <select name="xtippervereinalt" onChange="xtippervereinradio[1].checked=true">
      <option value='' {% if vereinAlt == '' %}selected{% endif %}>{{ t[51]|raw }}</option>
{% for verein in vereine %}
  <option value="{{ verein.name }}"{% if vereinAlt == verein.name %} selected{% endif %}>{{ verein.name }} [{{ verein.tipper }}]</option>
{% endfor %}
              </select>
            </td>
          </tr>
          <tr>
            <td width="20">&nbsp;</td>
            <td class="nobr" align="left"><input type="radio" name="xtippervereinradio" value="2" {% if vereinswahl == 2 %}checked{% endif %}>{{ t[49]|raw }}</td>
            <td class="nobr" align="left"><input class="lmo-formular-input" type="text" name="xtippervereinneu" size="25" maxlength="32" value="{{ vereinNeu }}" onFocus="xtippervereinradio[2].checked=true"></td>
          </tr>
{% endif %}
          <tr>
            <td class="lmost4" colspan="3" align="right">
              <input class="lmo-formular-button" type="submit" name="xtippersub" value="{{ text[329]|raw }}">
            </td>
          </tr>
          <tr>
            <td colspan="3" align="left"><p class="error"><img src="{{ bilder|raw }}/wrong.svg" border="0" width="20" alt=""> <strong>{{ t[82]|raw }}</strong> {{ t[137]|raw }}</p></td>
          </tr>
        </table>
      </form>
    </td>
  </tr>
{% else %}
  <tr>
    <td align="center"><p class="message"><img src="{{ bilder|raw }}/right.svg" border="0" width="20" alt=""> {{ t[121]|raw }}</p></td>
  </tr>
  <tr>
    <td class="lmoFooter" align="right"><a href="{{ adresse|raw }}?action=tipp&amp;todo=">{{ text[5]|raw }} {{ t[1]|raw }}</a></td>
  </tr>
{% endif %}
</table>
