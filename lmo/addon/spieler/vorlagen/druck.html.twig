{#- Spielerstatistik zum Drucken (Lmo\Addon\Spieler\Druckansicht). Spaltennamen und Werte sind fertiges HTML. -#}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"
                "http://www.w3.org/TR/html4/loose.dtd">
<html lang="{{ text[798]|raw }}">
  <head>
    <title>{{ t[18]|raw }}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" >
    <style type="text/css">
    body {background:#fff; color:#000; font:10pt sans-serif;}
    caption, p, h1 {margin:3pt auto; text-align:center;}
    table {border:1pt solid #000; border-radius:6px; margin:2pt auto;}
    td {padding:10; white-space:nowrap;}
    th {padding: 1pt;border-bottom: 1px solid #000; border-right: 1px solid #000;}
    h1 {font:14pt bolder;}
    .odd {background:#eee;}
    caption {margin-top:10pt; font-weight:bolder; white-space:nowrap;}
    @media print {
      a {display:none;}
    }
    </style>
  </head>
  <body>
    <script type="text/javascript">document.write('<small><a href="#" onClick="history.back();return false;">{{ text[562]|raw }}<\/a><\/small>');</script><center>
    <h1>{{ t[18]|raw }}{% if team != '' %} - {{ team }}{% endif %}
    </h1>
      <table cellpadding="0" cellspacing="1" border="0">
        <tr>
          <th colspan="2"></th>
{% for spalte in spalten %}
          <th class="nobr" align="center">{{ spalte|raw }}</th>
{% endfor %}
        </tr>
{% for zeile in zeilen %}
{% set klasse = zeile.ungerade ? ' class="odd"' : '' %}
        <tr>
          <td align="right"{{ klasse|raw }}><strong>{{ zeile.platz }}</strong></td>
          <td align="center"{{ klasse|raw }}>{{ zeile.bild|raw }}</td>
{% for zelle in zeile.zellen %}
          <td{{ klasse|raw }} align="{{ zelle.zahl ? 'center' : 'left' }}">{% if zelle.sortiert %}<strong>{% endif %}{{ zelle.wert|raw }}&nbsp;&nbsp;{% if zelle.sortiert %}</strong>{% endif %}</td>
{% endfor %}
        </tr>
{% endfor %}
      </table></center>
    <script type="text/javascript">document.write('<small><a href="#" onClick="history.back();return false;">{{ text[562]|raw }}<\/a><\/small>');</script>
  </body>
</html>
