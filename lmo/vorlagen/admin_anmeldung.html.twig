{# Anmeldung in der Administration (Lmo\Web\Admin\Anmeldung) #}
  <table class="lmoMain" cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td colspan="3" align="center"><h1>{{ text[77]|raw }} {{ text[54]|raw }}</h1></td>
    </tr>
    <tr>
      <td colspan="3" align="center">
        <form name="lmoedit" action="{{ selbst|raw }}" method="post">
          <input type="hidden" name="action" value="admin">
          <table class="lmoMiddle" width="99%" cellspacing="0" cellpadding="0" border="0">
            <tr>
              <td align="center"><h1>{{ text[305]|raw }}</h1></td>
            </tr>
            <tr>
              <td align="center">
                <table class="lmoInner" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td align="right"><acronym title="{{ text[307]|raw }}"> {{ text[306]|raw }}</acronym></td>
                    <td align="left"><input class="lmo-formular-input" type="text" name="xusername" size="16" maxlength="32" value="{{ name|raw }}"></td>
                  </tr>
                  <tr>
                    <td align="right"><acronym title="{{ text[309]|raw }}"> {{ text[308]|raw }}</acronym></td>
                    <td align="left"><input class="lmo-formular-input" type="password" name="xuserpass" size="16" maxlength="32" value=""></td>
                  </tr>
                  <tr>
                    <td align="left">&nbsp;</td>
                    <td align="left"><input title="{{ text[311]|raw }}" class="lmo-formular-button" type="submit" name="xusersub" value="{{ text[310]|raw }}"></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td align="center" class="lmoMenu"><a href="{{ adresse }}/lmo.php" title="{{ text[470]|raw }}">{{ text[469]|raw }}</a></td>
            </tr>
          </table>
        </form>
      </td>
    </tr>
{% if sprachwahl != '' %}
    <tr>
      <td class="lmoFooter" colspan="3" align="left">{{ sprachwahl|raw }}</td>
    </tr>
{% endif %}
    <tr>
      <td class="lmoFooter" colspan="3" align="center">
        <p>{{ text[54]|raw }}<br>Copyright {{ text[55]|raw }}</p>
        <p>LigaManager Online comes with ABSOLUTELY NO WARRANTY.</p>
        <p>This is free software, and you are welcome to redistribute it under certain conditions.</p>
        <p>Read <a href="{{ adresse }}/license.txt" target="_blank" title="GPL - GNU General Public License">this</a> for details.</p>
      </td>
    </tr>
  </table>
