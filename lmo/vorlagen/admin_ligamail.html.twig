{# Liga per E-Mail, eigenes Fenster (Lmo\Web\Admin\LigaMailSeite) #}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"
                "http://www.w3.org/TR/html4/loose.dtd">
<html lang="{{ text[798] }}">
<head>
<title>LMO Admin</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" >
<link rel="stylesheet" type="text/css" href="{{ adresse }}/lmo-style.php">
</head>
<body>
<div class="lmoMain">
{% if formular %}
  <form action="{{ formular.ziel|raw }}">
    <label>Mailadresse: <input name="madr" type="text" class="lmo-formular-input" size="25" maxlength="128"></label>
    <input type="hidden" name="action" value="admin">
    <input type="hidden" name="todo" value="email">
    <input type="hidden" name="down" value="{{ formular.down|raw }}">
    <input type="submit" value="Senden">
  </form>
{% else %}
{{ meldung|raw }}
{% endif %}
{% if formular or schliessen %}
  <p><script type="text/javascript">document.write('<a href="#" onclick="self.close();">{{ text[347]|raw }}<\/a>');</script></p>
{% endif %}
</body>
</html>
