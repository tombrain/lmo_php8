span.colorpicker {
  background-image:url("{{ bilder|raw }}/blank.gif");
  border:               1px solid #000;
  font-size:            15px;
  text-decoration:      none;
  width:                11px;
  height:               11px;
  background-position:  center center;
  background-repeat:    no-repeat;
  background-color:     transparent;
  margin:               0 2px;
  display:inline;
  cursor:crosshair;
}

span.colorpicker.nocolor {
  display:              inline;
  background-image:     url("{{ bilder|raw }}/transparent.gif");
  background-repeat:    repeat;
}
span.colorpicker.invalid {
  display:              inline;
  background-image:     url("{{ bilder|raw }}/attention.svg");
  background-position:  center;
  background-repeat:    no-repeat;
  border:               0;
}

span.colorpicker table {
  background:#fff;
  color:#000;
}

.sortarrow {
  background-image:     url("{{ bilder|raw }}/blank.png");
  width:                11px;
  height:               11px;
  background-position:  center center;
  background-repeat:    no-repeat;
  margin:               0 2px;
  display:inline;
}

.sortarrow.descending {
  display:inline;
  background-image:    url("{{ bilder|raw }}/downsimple.png");
}

.sortarrow.ascending {
  display:inline;
  background-image:    url("{{ bilder|raw }}/upsimple.png");
}
a span.popup, a:link span.popup{
