/* Das schwebende Infofenster mit abgerundetem Rahmen */
.lmo-smart-tooltip {
    position: fixed;
    visibility: hidden;
    opacity: 0;
    width: 250px;              /* Breite des Tooltipfensters */
    background-color: #ffffff; /* Reinweißer Hintergrund */
    color: #333333;            /* Dunkelgrauer Text */
    padding: 15px;             /* Mehr Innenabstand für Luftigkeit */

    /* Abgerundeter Rahmen */
    border: 1px solid #dddddd; /* Dezenter grauer Rand */
    border-radius: 12px;       /* Deutlich abgerundete Ecken */

    /* Schatten für den "Floating"-Effekt */
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);

    z-index: 10000;
    transition: opacity 0.25s ease;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 12px;
    line-height: 1.5;
    pointer-events: none;      /* Maus "fällt durch" das Fenster */
    word-wrap: break-word;
}

/* Die erste Zeile im Tooltip (Teams & Ergebnis) */
.lmo-smart-tooltip strong {
    display: block;                   /* Macht aus dem Inline-Tag einen Block über die volle Breite */
    text-align: center;               /* Zentriert den Inhalt */
    margin-bottom: 10px;              /* Abstand zum nachfolgenden Text */
    padding-bottom: 8px;              /* Abstand zur Trennlinie */
    border-bottom: 1px solid #eeeeee; /* Trennlinie unter der Überschrift */
    font-size: 10px;                  /* Optional: Überschrift etwas größer */
    line-height: 1.3;
}

/* Zentriert auch die Team-Icons innerhalb des starken Tags */
.lmo-smart-tooltip strong img {
    vertical-align: middle;  /* Richtet Icons mittig zum Text aus */
    margin: 0 5px;           /* Kleiner Abstand links/rechts vom Icon */
}

/* Der restliche Text im Fenster bleibt linksbündig */
.lmo-smart-tooltip {
    text-align: left;
    white-space: normal;     /* Verhindert, dass alles in einer Zeile klebt */
}
