{# Die Benutzer der Administration (Lmo\Web\Admin\BenutzerController), bis 4.5 lmo-adminuser.php #}
      <table class="lmoSubmenu" width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td align="center"><a href="{{ adresse }}?action=admin&amp;todo=options" onclick="return chklmolink();" title="{{ text[320]|raw }}">{{ text[319]|raw }}</a></td>
          <td align="center"><a href="{{ adresse }}?action=admin&amp;todo=addons" onclick="return chklmolink();" title="{{ text[498]|raw }}">{{ text[497]|raw }}</a></td>
          <td align="center"><a href="{{ adresse }}?action=admin&amp;todo=design" onclick="return chklmolink();" title="{{ text[422]|raw }}">{{ text[421]|raw }}</a></td>
          <td align="center">{{ text[317]|raw }}</td>
        </tr>
      </table>

      <table class="lmoMiddle" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td align="center" colspan="2"><h1>{{ text[321]|raw }}</h1></td>
        </tr>
        <tr>
          <td valign="top">
            <table class="lmoMenu" cellspacing="0" cellpadding="0" border="0">
{% for konto in konten %}
{% set name = konto[2] == 2 ? '<em>' ~ konto[0]|e ~ '</em>' : konto[0]|e %}
              <tr>
                <td align="right">{% if loop.index0 == show %} {{ name|raw }}
{% else %}<a href="{{ adresse }}?action=admin&amp;todo=user&amp;show={{ loop.index0 }}">{{ name|raw }}</a>{% endif %}</td>
              </tr>
{% endfor %}
            </table>
          </td>
          <td align="center" valign="top">
            <form name="lmoedit{{ show }}" action="{{ adresse }}" method="post">
              <input type="hidden" name="action" value="admin">
              <input type="hidden" name="todo" value="user">
              <input type="hidden" name="save" value="{{ show }}">
              <table class="lmoInner" cellspacing="0" cellpadding="0" border="0">
{% if show == -1 and konten is not empty %}
                <tr>
                  <td align="center">&nbsp;<br>{{ text[318]|raw }}<br>&nbsp;</td>
                </tr>
{% endif %}
{% for konto in konten|filter((k, i) => i == show) %}
                <tr>
                  <td align="right">{{ text[306]|raw }}</td>
                  <td align="left" colspan="2"><input class="lmo-formular-input" type="text" name="xadmin_name{{ show }}" size="16" maxlength="32" value="{{ konto[0] }}"></td>
                </tr>
                <tr>
                  <td align="right">{{ text[308]|raw }}</td>
                  <td align="left" colspan="2"><input class="lmo-formular-input" type="password" name="xadmin_pass{{ show }}" size="16" maxlength="32" value=""></td>
                </tr>
                <tr>
                  <td align="right" rowspan="2">{{ text[324]|raw }}</td>
                  <td align="left" colspan="2"><input onClick="document.lmoedit{{ show }}.xadmin_erweitert{{ show }}.disabled=true" class="lmo-formular-input" type="radio" name="xadmin_rang{{ show }}" value="2" {% if konto[2] == 2 %} checked{% endif %}>{{ text[326]|raw }}</td>
                </tr>
                <tr>
                  <td align="left" colspan="2"><input onClick="document.lmoedit{{ show }}.xadmin_erweitert{{ show }}.disabled=false" class="lmo-formular-input" type="radio" name="xadmin_rang{{ show }}" value="1" {% if konto[2] == 1 %} checked{% endif %}>{{ text[325]|raw }}</td>
                </tr>
                <tr>
                  <td>&nbsp;</td>
                  <td align="left"><input class="lmo-formular-input" type="checkbox" name="xadmin_erweitert{{ show }}" {% if (konto[4] ?? '') == 1 %} checked{% endif %} {% if konto[2] == 2 %} disabled{% endif %}><acronym title="{{ text[560]|raw }}">{{ text[559]|raw }}</acronym></td>
                </tr>
{% if konto[2] == 1 %}
                <tr>
                  <th colspan="3"><acronym title="{{ text[398]|raw }}">{{ text[397]|raw }}</acronym></th>
                </tr>
{% for liga in ligen %}
                <tr>
                  <td align="left" class="lmost5" colspan="3"><input class="lmo-formular-input" type="checkbox" name="xhelfer_ligen{{ show }}[]" value="{{ liga.datei }}"{% if liga.frei %} checked{% endif %}>{{ liga.name }}</td>
                </tr>
{% endfor %}
{% endif %}
                <tr>
                  <td>&nbsp;</td>
                  <td align="center"><acronym title="{{ text[327]|raw }}"><input class="lmo-formular-button" type="submit" value="{{ text[329]|raw }}"></acronym></td>
{% if show != 0 %}
                  <td align="right"><a href="{{ adresse }}?action=admin&amp;todo=user&amp;del={{ show }}" onclick="return confirm('{{ text[499]|raw }}');"><img border="0" height="18" src="{{ bilder }}/delete.svg" alt="{{ text[82]|raw }}" title="{{ text[328]|raw }}"></a></td>
{% endif %}
                </tr>
{% endfor %}
              </table>
            </form>
          </td>
        </tr>
        <tr>
          <th colspan="2"><h1>{{ text[331]|raw }}</h1></th>
        </tr>
        <tr>
          <td align="center" colspan="2">
            <form name="lmoeditx" action="{{ adresse }}" method="post">
              <input type="hidden" name="action" value="admin"><input type="hidden" name="todo" value="user"><input type="hidden" name="save" value="-1">
              <input type="hidden" name="show" value="{{ konten|length }}">
              <table class="lmoInner" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td align="right"><input class="lmo-formular-input" type="text" name="xadmin_name" size="16" maxlength="32" value="NeuerUser"></td>
                  <td align="left"><input class="lmo-formular-input" type="password" name="xadmin_pass" size="16" maxlength="32" value=""></td>
                  <td align="right"><input class="lmo-formular-button" type="submit" value="{{ text[329]|raw }}" title="{{ text[327]|raw }}"></td>
                </tr>
              </table>
            </form>
          </td>
        </tr>
      </table>
