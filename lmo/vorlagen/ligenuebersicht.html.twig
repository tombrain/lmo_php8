{#- Ligenuebersicht (Lmo\Web\Controller\LigenuebersichtController): die Ligen des Ordners, darunter
    seine Unterordner. Liste und Sprachtexte sind fertiges HTML. -#}
<table class="lmoMiddle" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td align="left">{{ liste|raw }}
    </td>
  </tr>
  <tr>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td align="left">
{% if ordner is not empty %}
      <table class='lmoInner' cellspacing="0" width="99%">
        <tr>
          <th style="text-align:center" colspan="2">{{ text[509]|raw }}</th>
        </tr>
{% for o in ordner %}
        <tr>
          <td><a href="{{ adresse|raw }}?subdir={{ o.pfad }}">{{ o.name }}</a></td>
{% if o.beschreibung != '' %}
          <td><small>{{ o.beschreibung|raw }}</small></td>
{% endif %}
        </tr>
{% endfor %}
      </table>
{% endif %}
{% if zurueck is not null %}
      <p><a href="{{ adresse|raw }}?subdir={{ zurueck }}">{{ text[5]|raw }} {{ text[562]|raw }}</a></p>
{% endif %}
    </td>
  </tr>
</table>
