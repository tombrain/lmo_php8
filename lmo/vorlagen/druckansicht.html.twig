{# Links zur Druckansicht unter der Seite (Lmo\Web\Seiten\Druckansicht) #}
<table width="100%" cellspacing="0" cellpadding="0" border="0">
  <tr>
{% for link in links %}
    <td align="center">{% if link %}<a href="{{ link.adresse|raw }}" title="{{ link.titel|raw }}">{{ link.name|raw }}</a>&nbsp;{% endif %}
    </td>
{% endfor %}
  </tr>
</table>
