{# Druckansicht <liga>-st.html: Spieltag, Tabelle und folgender Spieltag (Lmo\Web\Druckdateien) #}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"
        "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
  <title>{{ name|raw }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" >
  <style type="text/css">
    body {background:#fff; color:#000; font:10pt sans-serif;}
    caption, p, h1 {margin:3pt auto; text-align:center;}
    table {border:1pt solid #000; border-radius:6px; margin:2pt auto;}
    td {padding:10; white-space:nowrap;}
    th {border-bottom:1px solid #000;}
    h1 {font:14pt bolder;}
    caption {margin-top:10pt; font-weight:bolder; white-space:nowrap;}
    @media print {
      a {display:none;}
    }
  </style>
</head>
<body>
  <script type="text/javascript">document.write('<small><a href="#" onClick="history.back();return false;">{{ text[562]|raw }}<\/a><\/small>');</script>
  <h1>{{ name|raw }}</h1>
{% if angesetzt %}
  <table>
  <caption>{{ st }}. {{ text[2]|raw }} {% if datum %} - {{ datum[0]|raw }} {{ text[4]|raw }} {{ datum[1]|raw }}{% endif %}</caption>
{% for s in spiele %}
    <tr>
      <td>{{ s.anstoss|raw }}&nbsp;</td>
      <td align="right">{{ s.heim|raw }}</td><td>{{ s.heimBild|raw }}</td>
      <td>-</td>
      <td>{{ s.gastBild|raw }}</td><td>{{ s.gast|raw }}&nbsp;</td>
      <td align="right">{{ s.toreHeim }}</td>
      <td>:</td>
      <td align="left">{{ s.toreGast }}</td>
{% if s.gegenBeide %}
      <td width="2">/</td>
      <td align="right">{{ s.toreGast }}</td>
      <td align="center" width="8">:</td>
      <td align="left">{{ s.toreHeim }}</td>
{% endif %}
    </tr>
{% endfor %}
  </table>
{% if spielfrei is not null %}
  {% if spielfrei %}<p><small>{{ text[4004]|raw }}: {% endif %}{% for n in spielfrei %}{{ n|raw }}&nbsp;&nbsp;{% endfor %}
  </small></p>
{% endif %}
{% endif %}
  <table>
    <caption>{{ text[16]|raw }} - {{ st }}. {{ text[2]|raw }}</caption>
    <tr>
      <th colspan=3>&nbsp;</th>
      <th>{{ text[33]|raw }}</th>
      <th colspan=2>{{ text[37]|raw }}</th>
      <th>{{ text[38]|raw }}&nbsp;</th>
      <th align="right" >&nbsp;&nbsp;{{ text[39]|raw }}</th>
    </tr>
{% for z in tabelle %}
    <tr>
      <td align="right">{{ z.platz }}&nbsp;</td>
      <td>{{ z.bild|raw }}&nbsp;</td>
      <td>{{ z.name|raw }}&nbsp;</td>
      <td align="right">{{ z.spiele }}&nbsp;</td>
{% if minuspunkte %}
      <td align="right">{{ z.punkte }}:</td>
      <td align="left">{{ z.minuspunkte }}&nbsp;</td>
{% else %}
      <td align="right">{{ z.punkte }}</td>
      <td align="left">&nbsp;</td>
{% endif %}
      <td align="right">{{ z.tore }}:{{ z.gegentore }}&nbsp;</td>
      <td align="right">&nbsp;&nbsp;{{ z.differenz }}</td>
    </tr>
{% endfor %}
  </table>
  <p><small>{{ text[576]|raw }}</small></p>
{% if letzter %}
  <p><strong>{{ text[568]|raw }}</strong></p>
{% elseif folge %}
  <table>
  <caption>{{ folge.st }}. {{ text[2]|raw }}{% if folge.datum %} - {{ folge.datum[0]|raw }} {{ text[4]|raw }} {{ folge.datum[1]|raw }}{% endif %}</caption>
{% for s in folge.spiele %}
    <tr>
      <td>{{ s.anstoss|raw }}&nbsp;</td>
      <td align="right">{{ s.heim|raw }}</td>
      <td>{{ s.heimBild|raw }}</td>
      <td>-</td>
      <td>{{ s.gastBild|raw }}</td>
      <td>{{ s.gast|raw }}&nbsp;</td>
      <td align="right">{{ s.toreHeim }}</td>
      <td>:</td>
      <td align="left">{{ s.toreGast }}</td>
{% if s.gegenBeide %}
      <td width="2">/</td>
      <td align="right">{{ s.toreGast }}</td>
      <td align="center" width="8">:</td>
      <td align="left">{{ s.toreHeim }}</td>
{% endif %}
    </tr>
{% endfor %}
  </table>
{% if folge.spielfrei is not null %}
  {% if folge.spielfrei %}<p><small>{{ text[4004]|raw }}: {% endif %}{% for n in folge.spielfrei %}{{ n|raw }}&nbsp;&nbsp;{% endfor %}
  </small></p>
{% endif %}
{% endif %}
  <script type="text/javascript">document.write('<small><a href="#" onClick="history.back();return false;">{{ text[562]|raw }}<\/a><\/small>');</script>
</body>
</html>
