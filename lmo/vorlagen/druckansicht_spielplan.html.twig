{# Druckansicht <liga>-sp.html: Spielplan und Tabelle (Lmo\Web\Druckdateien) #}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"
        "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
  <title>{{ name|raw }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" >
  <style type="text/css">
    body {background:#fff; color:#000; font:10pt sans-serif;}
    caption, p, h1 {margin:3pt auto; text-align:center;}
    table {margin:auto; max-width:200mm;}
    #tabelle{border:1pt solid #000; border-radius:6px; margin:2pt auto;}
    table table {border:1pt solid #000; margin:20pt 0 2pt; border-radius:6px; auto; width:100%;}
    td {padding:10; white-space:nowrap;}
    th {border-bottom:1px solid #000;}
    h1 {font:14pt bolder;}
    caption {font-weight:bolder; white-space:nowrap;}
  </style>
</head>
<body>
  <script type="text/javascript">document.write('<small><a href="#" onClick="history.back();return false;">{{ text[562]|raw }}<\/a><\/small>');</script>
  <h1>{{ name|raw }}</h1>
  <table>
    <tr>
      <td>
{% for t in spieltage %}
{% if t.angesetzt %}
        <table>
        <caption>{{ t.st }}. {{ text[2]|raw }}{% if t.datum %} - {{ t.datum[0]|raw }} {{ text[4]|raw }} {{ t.datum[1]|raw }}{% endif %}</caption>
{% for s in t.spiele %}
          <tr>
            <td>{{ s.anstoss|raw }}&nbsp;</td>
            <td align="right">{{ s.heim|raw }}</td>
            <td>{{ s.heimBild|raw }}</td>
            <td>-</td>
            <td>{{ s.gastBild|raw }}</td>
            <td>{{ s.gast|raw }}&nbsp;</td>
            <td align="right">{{ s.toreHeim }}</td>
            <td>:</td>
            <td align="left">{{ s.toreGast }}</td>
{% if s.gegenBeide %}
            <td width="2">/</td>
            <td align="right">{{ s.toreGast }}</td>
            <td align="center" width="8">:</td>
            <td align="left">{{ s.toreHeim }}</td>
{% endif %}
          </tr>
{% endfor %}
        </table>
{% endif %}
{% if t.spielfrei is not null %}
      {% if t.spielfrei %}<p><small>{{ text[4004]|raw }}: {% endif %}{% for n in t.spielfrei %}{{ n|raw }}&nbsp;&nbsp;{% endfor %}
      </small></p>
{% endif %}
{% endfor %}
      </td>
    </tr>
  </table>
  <table id="tabelle">
  <caption>{{ text[16]|raw }}</caption>
    <tr>
      <th colspan=3>&nbsp;</th>
      <th>{{ text[33]|raw }}</th>
      <th colspan=2>{{ text[37]|raw }}&nbsp;</th>
      <th>{{ text[38]|raw }}&nbsp;</th>
      <th align="right" >&nbsp;&nbsp;{{ text[39]|raw }}</th>
    </tr>
{% for z in tabelle %}
    <tr>
      <td align="right">{{ z.platz }}&nbsp;</td>
      <td>{{ z.bild|raw }}&nbsp;</td>
      <td>{{ z.name|raw }}&nbsp;</td>
      <td align="right">{{ z.spiele }}&nbsp;</td>
{% if minuspunkte %}
      <td align="right">{{ z.punkte }}:</td>
      <td align="left">{{ z.minuspunkte }}&nbsp;</td>
{% else %}
      <td align="right">{{ z.punkte }}
      </td>
      <td align="left">&nbsp;</td>
{% endif %}
      <td align="right">{{ z.tore }}:{{ z.gegentore }}&nbsp;</td>
      <td align="right">&nbsp;&nbsp;{{ z.differenz }}</td>
    </tr>
{% endfor %}
  </table>
  <script type="text/javascript">document.write('<small><a href="#" onClick="history.back();return false;">{{ text[562]|raw }}<\/a><\/small>');</script>
</body>
</html>
