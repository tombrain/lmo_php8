{#- Spielplan einer Mannschaft (Lmo\Web\Controller\SpielplanController). Links, Wappen, Hinweise
    und Sprachtexte sind fertiges HTML. -#}
<table class="lmoMiddle" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td valign="top" align="center">
{#- Auswahl der Mannschaften #}
      <table class="lmoMenu" cellspacing="0" cellpadding="0" border="0">
{% for m in mannschaften %}
        <tr>
          <td align="right">
            <acronym title="{{ text[23]|raw }}&nbsp;{{ m.name }}">{% if m.gewaehlt %}{{ m.kurz }}{% else %}<a href="{{ link|raw }}{{ m.nr }}">{{ m.kurz }}</a>{% endif %}</acronym>
          </td>
          <td>&nbsp;{{ m.wappen|raw }}</td>
        </tr>
{% endfor %}
      </table>
    </td>
    <td valign="top" align="center">
      <table class="lmoInner" cellspacing="0" cellpadding="0" border="0">
{% if gewaehlt == 0 %}
        <tr><td align="center">&nbsp;<br>{{ text[24]|raw }}<br>&nbsp;</td></tr>
{% else %}
{#- die Spiele der gewaehlten Mannschaft #}
{% for s in spiele %}
        <tr>
          <th style="text-align:right">&nbsp;<a href="{{ spieltag_link|raw }}{{ s.spieltag }}" title="{{ text[25]|raw }}">{{ s.spieltag }}</a>&nbsp;</th>
{% if anstoss %}
          <td style="width:2px;">&nbsp;</td>
          <td class="nobr">{{ s.anstoss }}</td>
{% endif %}
          <td style="width:2px;">&nbsp;</td>
          <td class="nobr" align="right">{% if s.heim.fett %}<strong>{% endif %}{{ s.heim.name }}{% if s.heim.fett %}</strong>{% endif %}&nbsp;{{ s.heim.wappen|raw }}</td>
          <td align="center" style="width:10px;">-</td>
          <td class="nobr" align="left">{{ s.gast.wappen|raw }}&nbsp;{% if s.gast.fett %}<strong>{% endif %}{{ s.gast.name }}{% if s.gast.fett %}</strong>{% endif %}</td>
          <td style="width:2px;">&nbsp;</td>
          <td align="right">{{ s.tore_heim }}</td>
          <td align="center" style="width:8px;">:</td>
          <td align="left">{{ s.tore_gast }}</td>
{% if verlaengerung %}
          <td style="width:2px;">&nbsp;</td>
          <td align="left">{{ s.zusatz|raw }}</td>
{% endif %}
          <td style="width:2px;">&nbsp;</td>
          {#- Spielbericht, Notiz und bisherige Ergebnisse (AddOn Team Vergleich) #}
          <td class="nobr">{% if s.bericht is not null %}{% if s.bericht != '' %}{{ s.bericht|raw }}{% endif %}&nbsp;{% endif %}{{ s.hinweis|raw }}{% if s.addon is not null %}&nbsp;{{ s.addon|raw }}{% endif %}</td>
        </tr>
{% endfor %}
{% endif %}
      </table>
    </td>
  </tr>
</table>
