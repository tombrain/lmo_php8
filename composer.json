{
    "name": "lmo/lmo-php8-tests",
    "description": "Entwicklungswerkzeuge (Golden-Master-Tests) fuer lmo_php8",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Lmo\\Tests\\GoldenMaster\\": "tests/GoldenMaster/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:record": "GOLDEN_MODE=record phpunit"
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "sort-packages": true
    }
}
