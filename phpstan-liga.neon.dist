# Alte Dateien, die am Dateianfang angeben, welche
# Variablen sie erwarten (@var): Stufe 6 statt Stufe 0.
# Besteht eine Datei aus phpstan-liga-basis.neon.dist auch Stufe 6, wandert sie hierher.
parameters:
    level: 6
    phpVersion:
        min: 80100
        max: 80599
    # Konstanten, die init.php erst zur Laufzeit anlegt (PATH_TO_LMO ...)
    bootstrapFiles:
        - phpstan-bootstrap.php
    # Klassen und Funktionen des LMO
    scanDirectories:
        - lmo
        - src
    paths:
        - lmo/addon/tipp/lmo-tippsavefile.php
        - lmo/lmo-adminanz.php
        - lmo/lmo-adminbasic.php
        - lmo/lmo-adminnew.php
        - lmo/lmo-adminsubnavi.php
        - lmo/lmo-admintab.php
        - lmo/lmo-openfiledat.php
        - lmo/lmo-saveliga.php
        - lmo/lmo-savehtml.php
        - lmo/lmo-savehtml1.php
        - lmo/lmo-anwendung.php
        - lmo/lmo-spieltagsmenu.php
